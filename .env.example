# CIVITAS Secure Digital Voting System - Environment Variables Template
# See backend/.env.example and frontend/.env.example for service-specific options.

# Public Backend URL for Frontend calls (Use Render backend in production, or http://localhost:8000/api/v1 for local dev)
NEXT_PUBLIC_API_URL="https://civitas-backend-adjg.onrender.com/api/v1"

# Allowed CORS Origins for Backend
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001,https://civitas-frontend.onrender.com"

