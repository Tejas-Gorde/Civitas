# CIVITAS Backend Environment Configuration Example
# Copy to .env and configure for local or remote deployment

APP_NAME="Secure Digital Voting API"
ENVIRONMENT="development"
DATABASE_URL="sqlite:///./voting.db"

# Security & CORS
JWT_SECRET="change-me-in-production-min-32-chars"
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001,https://civitas-frontend.onrender.com"

# Hardware Bridge Token
HARDWARE_BRIDGE_TOKEN="change-me-hardware-token"

# Biometrics Configuration
FACE_THRESHOLD=0.72
FINGERPRINT_THRESHOLD=80.0
RISK_THRESHOLD=25.0
