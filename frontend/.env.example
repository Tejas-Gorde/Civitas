# CIVITAS Frontend Environment Configuration Example
# Copy to .env.local for local development or remote deployment

# Base API URL pointing to FastAPI backend (or relative /api/v1 for Next.js proxy)
NEXT_PUBLIC_API_URL="/api/v1"

# Public Application URL for Remote Voting Links and QR Codes
# Set this to your active Cloudflare Tunnel HTTPS URL when testing phone voting:
# e.g., NEXT_PUBLIC_PUBLIC_APP_URL="https://delivery-shape-codes-awarded.trycloudflare.com"
NEXT_PUBLIC_PUBLIC_APP_URL="https://delivery-shape-codes-awarded.trycloudflare.com"
