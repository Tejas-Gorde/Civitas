# CIVITAS Frontend Environment Configuration Example
# Copy to .env.local for local development or remote deployment

# Base API URL pointing to FastAPI backend (Default Render backend URL for production)
NEXT_PUBLIC_API_URL="https://civitas-backend-adjg.onrender.com/api/v1"

# Public Application URL for Remote Voting Links and QR Codes
# Set this to your active Cloudflare Tunnel HTTPS URL or deployed frontend domain:
# e.g., NEXT_PUBLIC_PUBLIC_APP_URL="https://civitas-frontend.onrender.com"
NEXT_PUBLIC_PUBLIC_APP_URL="https://civitas-frontend.onrender.com"

